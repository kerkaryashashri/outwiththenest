<?xml version="1.0" encoding="UTF-8"?>
<jcr:root
    xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    xmlns:jcr="http://www.jcp.org/jcr/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Place About"
    sling:resourceType="cq/gui/components/authoring/dialog">

    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">

        <items jcr:primaryType="nt:unstructured">

            <eyebrow
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                name="./eyebrow"
                fieldLabel="Eyebrow text"
                value="EXPLORE CLEVEDON"/>

            <heading
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                name="./heading"
                fieldLabel="Heading"
                value="About this place"
                required="{Boolean}true"/>

            <description
                jcr:primaryType="nt:unstructured"
                sling:resourceType="cq/gui/components/authoring/dialog/richtext"
                name="./description"
                fieldLabel="Description"
                fieldDescription="Add one or more paragraphs about this place."
                useFixedInlineToolbar="{Boolean}true"
                required="{Boolean}true"/>

            <quote
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                name="./quote"
                fieldLabel="Optional highlight quote"
                fieldDescription="Example: Fresh air, happy faces and a brighter tomorrow."/>

        </items>
    </content>
</jcr:root>