<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:template="/conf/outwiththenest/settings/wcm/templates/page-content"
        jcr:primaryType="cq:PageContent"
        jcr:title="Search Results"
        sling:resourceType="outwiththenest/components/page"
        hideInNav="true">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="outwiththenest/components/container"
            layout="responsiveGrid">
            <container
                jcr:primaryType="nt:unstructured"
                sling:resourceType="outwiththenest/components/container">
                <container
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="outwiththenest/components/container"
                    layout="responsiveGrid">
                    <searchresults
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="outwiththenest/components/adventuresearchresults"
                        heading="Find your next little adventure"
                        sourcePage="/content/outwiththenest/gb/en"/>
                </container>
            </container>
        </root>
    </jcr:content>
</jcr:root>
