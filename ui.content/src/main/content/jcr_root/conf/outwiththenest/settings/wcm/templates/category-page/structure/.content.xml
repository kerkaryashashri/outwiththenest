<?xml version="1.0" encoding="utf-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0" jcr:primaryType="cq:Page">
  <jcr:content jcr:primaryType="cq:PageContent" cq:template="/conf/outwiththenest/settings/wcm/templates/category-page" cq:deviceGroups="[mobile/groups/responsive]" sling:resourceType="outwiththenest/components/page">
    <root jcr:primaryType="nt:unstructured" sling:resourceType="wcm/foundation/components/responsivegrid" layout="responsiveGrid">
      <header jcr:primaryType="nt:unstructured" sling:resourceType="outwiththenest/components/experiencefragment" fragmentVariationPath="/content/experience-fragments/outwiththenest/gb/en/site/header/master"></header>
      <container jcr:primaryType="nt:unstructured" sling:resourceType="outwiththenest/components/container" layout="responsiveGrid">
        <container jcr:primaryType="nt:unstructured" sling:resourceType="outwiththenest/components/container" layout="responsiveGrid" editable="{Boolean}true"></container>
      </container>
      <footer jcr:primaryType="nt:unstructured" sling:resourceType="outwiththenest/components/experiencefragment" fragmentVariationPath="/content/experience-fragments/outwiththenest/gb/en/site/footer/master"></footer>
    </root>
    <cq:responsive jcr:primaryType="nt:unstructured">
      <breakpoints jcr:primaryType="nt:unstructured">
        <phone jcr:primaryType="nt:unstructured" title="Phone" width="{Long}768"></phone>
        <tablet jcr:primaryType="nt:unstructured" title="Tablet" width="{Long}1200"></tablet>
      </breakpoints>
    </cq:responsive>
  </jcr:content>
</jcr:root>