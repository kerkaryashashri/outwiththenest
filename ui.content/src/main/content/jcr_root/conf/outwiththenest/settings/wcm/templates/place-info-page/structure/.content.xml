<?xml version="1.0" encoding="utf-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0" jcr:primaryType="cq:Page">
  <jcr:content jcr:primaryType="cq:PageContent" cq:template="/conf/outwiththenest/settings/wcm/templates/place-info-page" cq:deviceGroups="[mobile/groups/responsive]" sling:resourceType="outwiththenest/components/page">
    <root jcr:primaryType="nt:unstructured" sling:resourceType="wcm/foundation/components/responsivegrid" layout="responsiveGrid">
      <header jcr:primaryType="nt:unstructured" sling:resourceType="outwiththenest/components/experiencefragment" fragmentVariationPath="/content/experience-fragments/outwiththenest/gb/en/site/header/master"></header>
      <container jcr:primaryType="nt:unstructured" sling:resourceType="outwiththenest/components/container" layout="responsiveGrid">
        <container jcr:primaryType="nt:unstructured" sling:resourceType="outwiththenest/components/container" layout="responsiveGrid">
          <breadcrumb jcr:primaryType="nt:unstructured" sling:resourceType="outwiththenest/components/breadcrumb" editable="{Boolean}true" startLevel="4"></breadcrumb>
          <placedetailhero jcr:primaryType="nt:unstructured" sling:resourceType="outwiththenest/components/placedetailhero" editable="{Boolean}true"></placedetailhero>
          <container jcr:primaryType="nt:unstructured" sling:resourceType="outwiththenest/components/container" layout="responsiveGrid">
            <cq:responsive jcr:primaryType="nt:unstructured">
              <default jcr:primaryType="nt:unstructured" width="10" offset="1"></default>
              <tablet jcr:primaryType="nt:unstructured" width="12" offset="0"></tablet>
              <phone jcr:primaryType="nt:unstructured" width="12" offset="0"></phone>
            </cq:responsive>
            <placeabout jcr:primaryType="nt:unstructured" sling:resourceType="outwiththenest/components/placeabout" editable="{Boolean}true" heading="About this place">
              <cq:responsive jcr:primaryType="nt:unstructured">
                <default jcr:primaryType="nt:unstructured" width="5" offset="0"></default>
                <tablet jcr:primaryType="nt:unstructured" width="6" offset="0"></tablet>
                <phone jcr:primaryType="nt:unstructured" width="12" offset="0"></phone>
              </cq:responsive>
            </placeabout>
            <placepracticalinfo jcr:primaryType="nt:unstructured" sling:resourceType="outwiththenest/components/placepracticalinfo" editable="{Boolean}true" heading="Practical information">
              <cq:responsive jcr:primaryType="nt:unstructured">
                <default jcr:primaryType="nt:unstructured" width="5" offset="0"></default>
                <tablet jcr:primaryType="nt:unstructured" width="6" offset="0"></tablet>
                <phone jcr:primaryType="nt:unstructured" width="12" offset="0"></phone>
              </cq:responsive>
            </placepracticalinfo>
          </container>
          <placevisitmap jcr:primaryType="nt:unstructured" sling:resourceType="outwiththenest/components/placevisitmap" editable="{Boolean}true" heading="Plan your visit"></placevisitmap>
          <visitorinformation jcr:primaryType="nt:unstructured" sling:resourceType="outwiththenest/components/placeabout" editable="{Boolean}true" heading="Before you go"></visitorinformation>
        </container>
      </container>
      <footer jcr:primaryType="nt:unstructured" sling:resourceType="outwiththenest/components/experiencefragment" fragmentVariationPath="/content/experience-fragments/outwiththenest/gb/en/site/footer/master"></footer>
    </root>
    <cq:responsive jcr:primaryType="nt:unstructured">
      <breakpoints jcr:primaryType="nt:unstructured">
        <phone jcr:primaryType="nt:unstructured" title="Phone" width="{Long}768"></phone>
        <tablet jcr:primaryType="nt:unstructured" title="Tablet" width="{Long}1200"></tablet>
      </breakpoints>
    </cq:responsive>
  </jcr:content>
</jcr:root>