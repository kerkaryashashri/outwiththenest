<?xml version="1.0" encoding="utf-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0" jcr:primaryType="cq:Page">
  <jcr:content jcr:primaryType="cq:PageContent" cq:template="/conf/outwiththenest/settings/wcm/templates/category-page" cq:deviceGroups="[mobile/groups/responsive]" sling:resourceType="outwiththenest/components/page">
    <root jcr:primaryType="nt:unstructured" sling:resourceType="wcm/foundation/components/responsivegrid" layout="responsiveGrid">
      <container jcr:primaryType="nt:unstructured" sling:resourceType="outwiththenest/components/container" layout="responsiveGrid">
        <container jcr:primaryType="nt:unstructured" sling:resourceType="outwiththenest/components/container" layout="responsiveGrid">
          <breadcrumb jcr:primaryType="nt:unstructured" sling:resourceType="outwiththenest/components/breadcrumb" startLevel="4"></breadcrumb>
          <compactcategoryhero jcr:primaryType="nt:unstructured" sling:resourceType="outwiththenest/components/compactcategoryhero" titleFromPage="{Boolean}true" descriptionFromPage="{Boolean}true" titleType="h1" imageFromPageImage="{Boolean}false"></compactcategoryhero>
          <sectionintro jcr:primaryType="nt:unstructured" sling:resourceType="outwiththenest/components/sectionintro" title="Find your next family day out"></sectionintro>
          <discoverylisting jcr:primaryType="nt:unstructured" sling:resourceType="outwiththenest/components/discoverylisting" title="Places to explore" maxItems="0" showCount="{Boolean}true"></discoverylisting>
        </container>
      </container>
    </root>
  </jcr:content>
</jcr:root>