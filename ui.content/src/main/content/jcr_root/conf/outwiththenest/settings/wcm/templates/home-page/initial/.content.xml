<?xml version="1.0" encoding="utf-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0" jcr:primaryType="cq:Page">
  <jcr:content jcr:primaryType="cq:PageContent" cq:template="/conf/outwiththenest/settings/wcm/templates/home-page" cq:deviceGroups="[mobile/groups/responsive]" sling:resourceType="outwiththenest/components/page">
    <root jcr:primaryType="nt:unstructured" sling:resourceType="wcm/foundation/components/responsivegrid" layout="responsiveGrid">
      <container jcr:primaryType="nt:unstructured" sling:resourceType="outwiththenest/components/container" layout="responsiveGrid">
        <container jcr:primaryType="nt:unstructured" sling:resourceType="outwiththenest/components/container" layout="responsiveGrid">
          <herocarousel jcr:primaryType="nt:unstructured" sling:resourceType="outwiththenest/components/herocarousel">
            <hero jcr:primaryType="nt:unstructured" sling:resourceType="outwiththenest/components/hero" titleFromPage="{Boolean}true" titleType="h1" />
          </herocarousel>
          <adventurefinder jcr:primaryType="nt:unstructured" sling:resourceType="outwiththenest/components/adventurefinder" heading="Find your next little adventure" resultsPage="/content/outwiththenest/gb/en/search"></adventurefinder>
          <categorytiles jcr:primaryType="nt:unstructured" sling:resourceType="outwiththenest/components/categorytiles"></categorytiles>
          <container jcr:primaryType="nt:unstructured" sling:resourceType="outwiththenest/components/container" layout="responsiveGrid">
            <cq:responsive jcr:primaryType="nt:unstructured">
              <default jcr:primaryType="nt:unstructured" width="10" offset="1"></default>
              <tablet jcr:primaryType="nt:unstructured" width="12" offset="0"></tablet>
              <phone jcr:primaryType="nt:unstructured" width="12" offset="0"></phone>
            </cq:responsive>
            <title jcr:primaryType="nt:unstructured" sling:resourceType="outwiththenest/components/title" jcr:title="Places to inspire your next day out" type="h2">
              <cq:responsive jcr:primaryType="nt:unstructured">
                <default jcr:primaryType="nt:unstructured" width="10" offset="0"></default>
                <tablet jcr:primaryType="nt:unstructured" width="12" offset="0"></tablet>
                <phone jcr:primaryType="nt:unstructured" width="12" offset="0"></phone>
              </cq:responsive>
            </title>
            <discoverylisting jcr:primaryType="nt:unstructured" sling:resourceType="outwiththenest/components/discoverylisting" title="Explore things to do" sourcePage="/content/outwiththenest/gb/en/things-to-do" maxItems="3" showCount="{Boolean}false">
              <cq:responsive jcr:primaryType="nt:unstructured">
                <default jcr:primaryType="nt:unstructured" width="10" offset="0"></default>
                <tablet jcr:primaryType="nt:unstructured" width="12" offset="0"></tablet>
                <phone jcr:primaryType="nt:unstructured" width="12" offset="0"></phone>
              </cq:responsive>
            </discoverylisting>
          </container>
          <promobanner jcr:primaryType="nt:unstructured" sling:resourceType="outwiththenest/components/promobanner"></promobanner>
        </container>
      </container>
    </root>
  </jcr:content>
</jcr:root>